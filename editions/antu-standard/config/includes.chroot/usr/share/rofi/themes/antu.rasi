/*
 * Tema del Lanzador Antü (rofi), modo "drun" (apps instaladas).
 * Paleta: ver shared/branding/palette.md.
 */

* {
    antu-void:      #04070Dee;
    antu-navy:      #0A1730CC;
    antu-navy-hi:   #16294ACC;
    antu-cyan:      #5AD8FFFF;
    antu-glow:      #BFEFFFFF;
    antu-text:      #F2F9FFFF;
    antu-muted:     #7FA8C9FF;

    background-color: transparent;
    text-color:       @antu-text;
    font:             "Inter 12";
}

window {
    width:             42%;
    location:          center;
    anchor:            center;
    /* Degradé sutil (arriba más claro, abajo más oscuro) en vez de un
       relleno plano: da sensación de profundidad sin depender de sombras
       (esta versión de rofi no las soporta). IMPORTANTE: las variables
       @nombre no se pueden usar dentro de linear-gradient() en rofi
       1.7 — hay que repetir los valores hex literales acá. */
    background-image:  linear-gradient(to bottom, #24406FE6, #04070Dee);
    border:            2px;
    border-color:      @antu-cyan;
    border-radius:     16px;
    padding:           4px 24px 24px 24px;
}

mainbox {
    children: [ inputbar, separator, listview ];
    spacing:  0px;
}

inputbar {
    children:         [ entry ];
    background-color: @antu-navy;
    border-radius:    10px;
    padding:          12px 14px;
    margin:           20px 0px 16px 0px;
}

entry {
    placeholder:       "Buscar en Antü…";
    placeholder-color: @antu-muted;
}

separator {
    background-color: @antu-cyan;
    expand:            false;
    padding:           1px 0px;
    margin:            0px 0px 16px 0px;
}

listview {
    lines:             8;
    spacing:           4px;
    background-color:  transparent;
    scrollbar:         false;
}

element {
    padding:       9px 10px;
    border-radius: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color:        @antu-text;
}

element selected.normal {
    /* Literal, no variable: ver nota en el bloque de "window" más arriba. */
    background-image: linear-gradient(to bottom, #BFEFFF, #5AD8FF);
    text-color:        @antu-void;
}

/* El color de texto de "element" no lo hereda el sub-widget que
   realmente dibuja el texto (element-text): hay que fijarlo acá también,
   si no el texto (y el fragmento resaltado por la búsqueda) queda
   blanco sobre el fondo celeste claro del ítem seleccionado y no se lee. */
element-text {
    text-color: inherit;
}

element-text selected.normal {
    text-color: @antu-void;
}

element-icon {
    size: 24px;
}
