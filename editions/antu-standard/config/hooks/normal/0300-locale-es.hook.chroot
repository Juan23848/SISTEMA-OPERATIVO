#!/bin/sh
# Configura español (Argentina) como idioma por defecto del sistema.
#
# Con esto, la gran mayoría de los menús, categorías y textos genéricos
# de las aplicaciones aparecen en español de fábrica (usan la traducción
# que ya traen incluida), sin tener que tocar cada aplicación a mano. Los
# nombres propios de las apps (Firefox, Chromium, VLC) no se traducen
# -son marcas-, pero el resto de la interfaz sí.
#
# Validado de verdad (Xvfb + xfce4-appfinder): los nombres y categorías
# de las aplicaciones se traducen correctamente. La cobertura de textos
# de la propia interfaz de cada herramienta (botones, títulos de
# ventana) depende de qué tan completa sea la traducción que traiga cada
# paquete — puede variar entre programas.
set -e

sed -i 's/^# *\(es_AR.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen es_AR.UTF-8
update-locale LANG=es_AR.UTF-8 LC_MESSAGES=es_AR.UTF-8
