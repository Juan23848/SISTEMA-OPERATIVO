# Compatibilidad "enchufar y usar": que un pendrive o disco externo,
# venga formateado como venga (FAT32/exFAT/NTFS, típico si se usó antes
# en Windows), monte solo al conectarlo, sin configurar nada a mano.
udisks2
gvfs
gvfs-backends
policykit-1
ntfs-3g
exfatprogs
dosfstools

# Archivos comprimidos: file-roller (ya en apps.list) es solo la
# interfaz gráfica — sin estos paquetes no puede abrir de verdad un
# .zip/.rar/.7z, que son los formatos más comunes viniendo de Windows.
# unrar es non-free (ya habilitado globalmente por el firmware de
# wifi/bluetooth, ver auto/config) pero da soporte real de RAR5, a
# diferencia de unrar-free.
zip
unzip
p7zip-full
unrar

# wget y gnupg: los necesita el hook que configura el repositorio
# oficial de Google Chrome (ver hooks/normal/0700-google-chrome-repo),
# para bajar y verificar la clave de firma antes de instalar nada.
wget
gnupg

# Flatpak: instalar apps modernas empaquetadas fuera de los repos de
# Debian (Flathub) con un clic, sin depender de que Antü tenga el
# paquete. El remote de Flathub se agrega en un hook de build.
flatpak
gnome-software
gnome-software-plugin-flatpak

# AppImage: que un .AppImage descargado ande con solo darle doble clic
# y marcarlo ejecutable, como un .exe portable en Windows.
libfuse2

# Fuentes métricamente compatibles con las de Office (Arial, Times New
# Roman, Courier New, Calibri, Cambria). Sin esto, abrir en LibreOffice
# un .docx/.xlsx hecho en Windows sustituye esas fuentes por otras de
# ancho distinto y el documento se ve corrido/roto aunque el contenido
# esté intacto.
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea
