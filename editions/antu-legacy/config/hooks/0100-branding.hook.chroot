#!/bin/sh
# Sobrescribe /etc/os-release para que el sistema se identifique como
# Antü Legacy en vez de Debian genérico.
set -e

cat > /etc/os-release <<'EOF'
PRETTY_NAME="Antü Legacy"
NAME="Antü OS"
VERSION="Legacy"
ID=antu
ID_LIKE=debian
HOME_URL="https://github.com/Juan23848/SISTEMA-OPERATIVO"
EOF

cp /etc/os-release /etc/lsb-release 2>/dev/null || true
