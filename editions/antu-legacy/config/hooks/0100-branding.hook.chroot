#!/bin/sh
# Sobrescribe /etc/os-release para que el sistema se identifique como
# Antü Legacy en vez de Debian genérico.
set -e

cat > /etc/os-release <<'EOF'
PRETTY_NAME="Antü Legacy"
NAME="Antü OS"
VERSION="Legacy"
ID=antu
ID_LIKE=debian
HOME_URL="https://github.com/Juan23848/SISTEMA-OPERATIVO"
EOF

# /etc/lsb-release usa un formato de claves distinto al de os-release
# (DISTRIB_* en vez de NAME=/VERSION=/ID=) — copiar el archivo tal cual
# no genera esas claves, y algunos programas viejos que solo miran
# lsb-release quedan sin detectar nada. Encontrado en una revisión
# externa (Codex) y confirmado leyendo el formato real de lsb-release.
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=Antu
DISTRIB_RELEASE=Legacy
DISTRIB_CODENAME=bookworm
DISTRIB_DESCRIPTION="Antü Legacy"
EOF
