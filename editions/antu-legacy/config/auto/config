#!/bin/sh
# Configuración de live-build para Antü Legacy.
# Pensada para hardware de la era Windows XP: poca RAM, sin GPU confiable.
set -e

lb config noauto \
    --mode debian \
    --architectures "i386" \
    --distribution "bookworm" \
    --binary-images "iso-hybrid" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer "live" \
    --memtest "none" \
    --iso-application "Antu Legacy" \
    --iso-volume "ANTU_LEGACY" \
    --iso-publisher "Antu OS Project" \
    "${@}"
