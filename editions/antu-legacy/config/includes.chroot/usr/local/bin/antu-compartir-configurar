#!/bin/sh
# Habilita la carpeta compartida de Antü (/srv/antu-compartido, visible
# desde Windows como \\<nombre-de-la-pc>\Compartido) para el usuario que
# corre este script. Un solo comando en vez de que el usuario tenga que
# saber que existen dos pasos separados (sumarse al grupo Unix +
# configurar una contraseña de Samba, distinta de la de Linux).
#
# Por qué no viene habilitado de fábrica: Windows 10/11 actualizado
# restringe por política el acceso de invitado a carpetas compartidas, y
# dejar escritura anónima abierta en la red no es un buen default. Ver
# el encabezado de /etc/samba/smb.conf.
set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "Este comando necesita permisos de administrador. Probá:"
    echo "  sudo antu-compartir-configurar"
    exit 1
fi

TARGET_USER="${SUDO_USER:-${1:-}}"
if [ -z "$TARGET_USER" ]; then
    echo "Uso: sudo antu-compartir-configurar [usuario]"
    echo "(si corrés con 'sudo' directamente, usa tu propio usuario sin indicarlo)"
    exit 1
fi

usermod -aG antu-compartido "$TARGET_USER"

echo "Ahora configurá la contraseña para compartir archivos (puede ser"
echo "distinta a tu contraseña de inicio de sesión):"
smbpasswd -a "$TARGET_USER"
smbpasswd -e "$TARGET_USER"

echo ""
echo "Listo. Desde una PC con Windows en la misma red, la carpeta"
echo "compartida de Antü va a aparecer como \\\\$(hostname)\\Compartido"
echo "(usuario: $TARGET_USER, la contraseña que acabás de configurar)."
