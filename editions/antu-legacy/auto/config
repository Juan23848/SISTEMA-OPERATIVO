#!/bin/sh
# Configuración de live-build para Antü Legacy.
# Pensada para hardware modesto (poca RAM, sin GPU confiable), no para
# hardware literalmente de 32 bits: todo el rango real que se busca
# cubrir (Celeron e i3/i5 desde ~3ra generación en adelante, 4GB de
# RAM) ya es de 64 bits desde hace más de una década. Por eso, a
# diferencia de una versión anterior de este archivo, la arquitectura
# es "amd64" y no "i386" — usar i386 hoy solo suma un problema real sin
# resolver ninguno: hardware moderno sin BIOS/CSM (solo UEFI puro, ej.
# una laptop con un i3 de 12va gen) no tiene garantizado un camino de
# arranque de 32 bits, mientras que ese mismo hardware es exactamente
# el que sí debe poder arrancar amd64 sin problema. "Legacy" acá
# describe el perfil de escritorio (liviano, sin compositor, XFCE), no
# la arquitectura del CPU.
#
# --bootappend-live con locales=/keyboard-layouts=: el hook
# 0300-locale-es (que genera es_AR.UTF-8 y lo deja como LANG del
# sistema) alcanza para el sistema YA INSTALADO, pero no para la sesión
# live que arranca directo desde la ISO. Esa primera sesión la arma
# live-config en cada arranque, a partir de parámetros de arranque (no
# de lo que haya en el filesystem) — sin "locales=" acá, su componente
# 0050-locales usa en_US.UTF-8 por defecto y pisa /etc/default/locale al
# bootear, sin importar lo que haya quedado configurado durante el
# build. Encontrado en una revisión externa (Codex), confirmado contra
# el código fuente oficial de live-config de Debian bookworm.
#
# "boot=live components" al principio: sin esto la ISO NO ARRANCA.
# --bootappend-live no agrega texto a lo que live-build ya pone en la
# entrada de arranque por defecto ("Live system") — LO REEMPLAZA
# entero. Confirmado inspeccionando isolinux.cfg/grub.cfg dentro de una
# ISO real ya compilada (live-build 20230502 de Debian bookworm, no el
# de Ubuntu): la entrada por defecto quedaba con
# "append locales=es_AR.UTF-8 keyboard-layouts=latam" nada más, y al
# arrancarla el kernel caía a un shell de emergencia de initramfs
# ("No root device specified"). Solo la entrada "fail-safe" (que nadie
# usa) trae boot=live hardcodeado aparte. Un parche de una revisión
# externa (Codex) había señalado exactamente esto — se había
# descartado por error en un chequeo previo contra un live-build de
# Ubuntu bastante más viejo, que no representa el real. Corregido y
# revalidado arrancando la ISO de verdad en QEMU (en Standard; ver
# docs/ARCHITECTURE.md).
set -e

lb config noauto \
    --mode debian \
    --architectures "amd64" \
    --distribution "bookworm" \
    --binary-images "iso-hybrid" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer "live" \
    --memtest "none" \
    --bootappend-live "boot=live components locales=es_AR.UTF-8 keyboard-layouts=latam" \
    --iso-application "Antu Legacy" \
    --iso-volume "ANTU_LEGACY" \
    --iso-publisher "Antu OS Project" \
    "${@}"
