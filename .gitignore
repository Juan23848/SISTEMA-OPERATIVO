# Artefactos generados por live-build
editions/*/build/
# Branding copiado en build time por shared/scripts/install-branding.sh
# (no confundir con archivos que sí escribimos a mano dentro de
# includes.chroot, como el look-and-feel de Plasma en antu-pro).
editions/*/config/includes.chroot/usr/share/backgrounds/antu/
editions/*/config/includes.chroot/usr/share/pixmaps/antu/
editions/*/config/includes.chroot/usr/share/icons/Antu/
# Antü Resolver: copiado por scripts/build.sh desde la única fuente real
# (shared/resolver/antu-resolver). Tener una copia propia versionada acá
# fue justo el bug que hizo que dos rondas de correcciones al Resolver
# nunca llegaran a ninguna ISO (encontrado en una revisión externa).
editions/*/config/includes.chroot/usr/bin/antu-resolver

# auto/ y config/ tienen que ser HERMANOS (ambos hijos directos de
# editions/<edicion>/) para que live-build encuentre de verdad nuestros
# package-lists/hooks/includes.chroot dentro de config/ — si auto/
# quedara adentro de config/, "lb config" (corrido desde config/)
# crearía un config/config/ vacío al lado nuestro y jamás leería nada
# de lo que escribimos (bug real que tuvo el proyecto, corregido).
# Lo que sigue son los archivos/carpetas que "lb config"/"lb build"
# generan solos dentro de esa estructura — no son contenido nuestro.
editions/*/.build/
editions/*/local/
editions/*/cache/
editions/*/chroot/
editions/*/config/archives/
editions/*/config/binary/
editions/*/config/binary_debian-installer/
editions/*/config/binary_grub/
editions/*/config/binary_rootfs/
editions/*/config/binary_syslinux/
editions/*/config/bootstrap/
editions/*/config/chroot/
editions/*/config/chroot_apt/
editions/*/config/common/
editions/*/config/includes/
editions/*/config/includes.binary/
editions/*/config/includes.binary_debian-installer/
editions/*/config/packages/
editions/*/config/packages.binary/
editions/*/config/packages.chroot/
editions/*/config/preseed/
editions/*/config/source/
editions/*/config/templates/
*.iso
*.img
*.log
__pycache__/
*.pyc
